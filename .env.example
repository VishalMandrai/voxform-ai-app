# Environment variables go here, will be read by Pydantic Settings Model:
# -----------------------------------------------------------------------
#
# Copy this file to .env and fill in REAL values.

# MySQL connection string
DATABASE_URL=mysql+pymysql://voiceform:voiceform@localhost:3306/voiceform

# NOTE - for local MySQL Server
# 1. Start the local server 
# 2. Run commands in - db-startup-script.sql to create a DB and User
# 3. Above connection string works perfectly fine in that case.


# faster-whisper settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ALLOWED_LANGUAGE=en
AUDIO_UPLOAD_DIR=./uploaded_audio
MAX_AUDIO_SIZE_MB=25

# --- Groq Whisper API ---------------------------------------------  
whisper_api_key=put-real-api-key
whisper_api_model=whisper-large-v3-turbo
whisper_api_language=en
whisper_api_temperature=0.0

# --- Field extraction (OpenAI) -----------------------------------
LLM_api_key=put-real-api-key
LLM_model=openai/gpt-oss-20b

# --- Auth / JWT --------------------------------------------------
JWT_SECRET_KEY=generate-JWT-secret-key
JWT_EXPIRES_MINUTES=10080

# --- App ---------------------------------------------------------
APP_NAME=VoxForm_AI
DEBUG=True

